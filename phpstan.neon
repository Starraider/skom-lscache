includes:
    - vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
    level: 6
    paths:
        - Classes
        - Tests
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            message: '#Parameter \#1 \$handler of static method GuzzleHttp\\HandlerStack.* expects.*#'
            path: Tests/Unit/Backend/Probe/CacheProbeClientTest.php
