            <trans-unit id="probe.state.miss.title"><source>MISS</source><target>MISS</target></trans-unit>
            <trans-unit id="probe.state.miss.message"><source>The response was cacheable but not served from cache.</source><target>Die Antwort war cachebar, wurde aber nicht aus dem Cache ausgeliefert.</target></trans-unit>
            <trans-unit id="probe.state.not-cacheable.title"><source>NOT-CACHEABLE</source><target>NOT-CACHEABLE</target></trans-unit>
            <trans-unit id="probe.state.not-cacheable.message"><source>The response cannot be cached.</source><target>Die Antwort kann nicht gecacht werden.</target></trans-unit>
