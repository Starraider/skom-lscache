        <body>
            <trans-unit id="dashboard.title"><source>LiteSpeed Cache</source><target>LiteSpeed Cache</target></trans-unit>
            <trans-unit id="dashboard.heading"><source>Dashboard</source><target>Dashboard</target></trans-unit>
            <trans-unit id="dashboard.description"><source>Inspect purge totals and probe cache-hit status for the selected site.</source><target>Purge-Summen und Cache-Hit-Status für die gewählte Site prüfen.</target></trans-unit>
            <trans-unit id="dashboard.currentSite.label"><source>Current site</source><target>Aktuelle Site</target></trans-unit>
            <trans-unit id="dashboard.currentBase.label"><source>Default probe base</source><target>Standard-Probe-URL</target></trans-unit>

            <trans-unit id="dashboard.siteSelector.heading"><source>Site selector</source><target>Site-Auswahl</target></trans-unit>
            <trans-unit id="dashboard.siteSelector.label"><source>Site</source><target>Site</target></trans-unit>
            <trans-unit id="dashboard.siteSelector.help"><source>Choose a configured site before running the summary cards or the probe.</source><target>Wähle eine konfigurierte Site, bevor du die Kennzahlen oder die Probe ausführst.</target></trans-unit>
            <trans-unit id="dashboard.siteSelector.submit"><source>Load site</source><target>Site laden</target></trans-unit>
            <trans-unit id="dashboard.siteSelector.none"><source>No sites are configured yet.</source><target>Es sind noch keine Sites konfiguriert.</target></trans-unit>

            <trans-unit id="dashboard.summary.last24h.label"><source>Last 24 hours</source><target>Letzte 24 Stunden</target></trans-unit>
            <trans-unit id="dashboard.summary.last24h.description"><source>Purge rows created in the last 24 hours.</source><target>Purge-Einträge aus den letzten 24 Stunden.</target></trans-unit>
            <trans-unit id="dashboard.summary.last7d.label"><source>Last 7 days</source><target>Letzte 7 Tage</target></trans-unit>
            <trans-unit id="dashboard.summary.last7d.description"><source>Purge rows created in the last 7 days.</source><target>Purge-Einträge aus den letzten 7 Tagen.</target></trans-unit>
            <trans-unit id="dashboard.summary.last30d.label"><source>Last 30 days</source><target>Letzte 30 Tage</target></trans-unit>
            <trans-unit id="dashboard.summary.last30d.description"><source>Purge rows created in the last 30 days.</source><target>Purge-Einträge aus den letzten 30 Tagen.</target></trans-unit>

            <trans-unit id="dashboard.breakdown.title"><source>Site breakdown</source><target>Site-Verteilung</target></trans-unit>
            <trans-unit id="dashboard.breakdown.description"><source>All purge rows grouped by site identifier, including the unknown bucket.</source><target>Alle Purge-Einträge gruppiert nach Site-Identifier, einschließlich des unknown-Buckets.</target></trans-unit>
            <trans-unit id="dashboard.breakdown.columns.site"><source>Site</source><target>Site</target></trans-unit>
            <trans-unit id="dashboard.breakdown.columns.count"><source>Count</source><target>Anzahl</target></trans-unit>

            <trans-unit id="dashboard.recent.title"><source>Recent purges</source><target>Aktuelle Purges</target></trans-unit>
            <trans-unit id="dashboard.recent.description"><source>The five newest purge rows for the selected site.</source><target>Die fünf neuesten Purge-Einträge der gewählten Site.</target></trans-unit>
            <trans-unit id="dashboard.recent.empty"><source>No purge rows recorded for this site yet.</source><target>Für diese Site wurden noch keine Purge-Einträge erfasst.</target></trans-unit>
            <trans-unit id="dashboard.recent.columns.timestamp"><source>Timestamp</source><target>Zeitpunkt</target></trans-unit>
            <trans-unit id="dashboard.recent.columns.request"><source>Request ID</source><target>Request-ID</target></trans-unit>
            <trans-unit id="dashboard.recent.columns.source"><source>Source</source><target>Quelle</target></trans-unit>
