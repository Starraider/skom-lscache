            <trans-unit id="auditLog.heading"><source>Audit Log</source><target>Audit-Log</target></trans-unit>
            <trans-unit id="auditLog.description"><source>Inspect purge events with filterable diagnostics and export support.</source><target>Purge-Ereignisse mit Filterdiagnose und CSV-Export analysieren.</target></trans-unit>
            <trans-unit id="auditLog.exportCsv"><source>Export CSV</source><target>CSV exportieren</target></trans-unit>
            <trans-unit id="auditLog.exportTruncationWarning"><source>Export is limited to the newest %d rows for the selected filters.</source><target>Der Export ist auf die neuesten %d Zeilen für die gewählten Filter begrenzt.</target></trans-unit>
            <trans-unit id="auditLog.applyFilters"><source>Apply filters</source><target>Filter anwenden</target></trans-unit>
            <trans-unit id="auditLog.resetFilters"><source>Reset filters</source><target>Filter zurücksetzen</target></trans-unit>
            <trans-unit id="auditLog.emptyState"><source>No purges match these filters.</source><target>Keine Purges entsprechen diesen Filtern.</target></trans-unit>
            <trans-unit id="auditLog.expandTags"><source>Show tags</source><target>Tags anzeigen</target></trans-unit>

