            <trans-unit id="probe.title"><source>Cache-Hit Probe</source><target>Cache-Hit-Prüfung</target></trans-unit>
            <trans-unit id="probe.description"><source>Send a HEAD request and inspect the LiteSpeed cache headers.</source><target>Sendet eine HEAD-Anfrage und prüft die LiteSpeed-Cache-Header.</target></trans-unit>
            <trans-unit id="probe.target.label"><source>Target URL</source><target>Ziel-URL</target></trans-unit>
            <trans-unit id="probe.target.help"><source>Use an absolute URL or a path relative to the selected site base.</source><target>Verwende eine absolute URL oder einen Pfad relativ zur gewählten Site-Base.</target></trans-unit>
            <trans-unit id="probe.submit"><source>Probe cache status</source><target>Cache-Status prüfen</target></trans-unit>
            <trans-unit id="probe.loading"><source>Probing...</source><target>Prüfe ...</target></trans-unit>
            <trans-unit id="probe.placeholder.title"><source>No probe run yet</source><target>Noch keine Prüfung ausgeführt</target></trans-unit>
            <trans-unit id="probe.placeholder.message"><source>Enter a URL and run the probe to inspect the cache response.</source><target>Gib eine URL ein und starte die Prüfung, um die Cache-Antwort zu sehen.</target></trans-unit>
            <trans-unit id="probe.error.network"><source>The probe request could not reach the target.</source><target>Die Probe-Anfrage konnte das Ziel nicht erreichen.</target></trans-unit>
            <trans-unit id="probe.error.unexpected"><source>The probe request failed unexpectedly.</source><target>Die Probe-Anfrage ist unerwartet fehlgeschlagen.</target></trans-unit>
            <trans-unit id="probe.error.disallowedTarget"><source>The target host is not allowed for probing.</source><target>Der Ziel-Host ist für die Probe nicht erlaubt.</target></trans-unit>

            <trans-unit id="probe.state.hit.title"><source>HIT</source><target>HIT</target></trans-unit>
            <trans-unit id="probe.state.hit.message"><source>The response was served from cache.</source><target>Die Antwort wurde aus dem Cache ausgeliefert.</target></trans-unit>
            <trans-unit id="probe.state.miss.title"><source>MISS</source><target>MISS</target></trans-unit>
            <trans-unit id="probe.state.miss.message"><source>The response was cacheable but not served from cache.</source><target>Die Antwort war cachebar, wurde aber nicht aus dem Cache ausgeliefert.</target></trans-unit>
            <trans-unit id="probe.state.not-cacheable.title"><source>NOT-CACHEABLE</source><target>NOT-CACHEABLE</target></trans-unit>
            <trans-unit id="probe.state.not-cacheable.message"><source>The response cannot be cached.</source><target>Die Antwort kann nicht gecacht werden.</target></trans-unit>
            <trans-unit id="probe.state.no-lscache-header.title"><source>NO-LSCACHE-HEADER</source><target>NO-LSCACHE-HEADER</target></trans-unit>
            <trans-unit id="probe.state.no-lscache-header.message"><source>The response did not expose a LiteSpeed cache header.</source><target>Die Antwort hat keinen LiteSpeed-Cache-Header geliefert.</target></trans-unit>
            <trans-unit id="probe.state.timeout.title"><source>TIMEOUT</source><target>TIMEOUT</target></trans-unit>
            <trans-unit id="probe.state.timeout.message"><source>The probe request timed out.</source><target>Die Probe-Anfrage ist in ein Timeout gelaufen.</target></trans-unit>
            <trans-unit id="probe.state.http-error.title"><source>HTTP-ERROR</source><target>HTTP-ERROR</target></trans-unit>
            <trans-unit id="probe.state.http-error.message"><source>The probe request returned an HTTP error.</source><target>Die Probe-Anfrage hat einen HTTP-Fehler zurückgegeben.</target></trans-unit>

            <trans-unit id="probe.details.header"><source>Header %s reported %s.</source><target>Der Header %s meldet %s.</target></trans-unit>
            <trans-unit id="probe.details.statusCode"><source>HTTP status %d.</source><target>HTTP-Status %d.</target></trans-unit>
            <trans-unit id="probe.details.noHeader"><source>No LiteSpeed cache header was returned.</source><target>Es wurde kein LiteSpeed-Cache-Header zurückgegeben.</target></trans-unit>
            <trans-unit id="probe.details.timeout"><source>The request exceeded the 3-second timeout.</source><target>Die Anfrage hat das 3-Sekunden-Timeout überschritten.</target></trans-unit>
            <trans-unit id="probe.details.requestFailed"><source>The probe request could not be completed.</source><target>Die Probe-Anfrage konnte nicht abgeschlossen werden.</target></trans-unit>
            <trans-unit id="probe.details.disallowedTarget"><source>Use the selected site host, or configure lscache.probe.allowedHosts in site settings.</source><target>Verwende den Host der gewählten Site oder konfiguriere lscache.probe.allowedHosts in den Site-Einstellungen.</target></trans-unit>
