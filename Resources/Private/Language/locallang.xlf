            <trans-unit id="dashboard.title"><source>LiteSpeed Cache</source></trans-unit>
            <trans-unit id="dashboard.heading"><source>Dashboard</source></trans-unit>
            <trans-unit id="dashboard.description"><source>Inspect purge totals and probe cache-hit status for the selected site.</source></trans-unit>
            <trans-unit id="dashboard.currentSite.label"><source>Current site</source></trans-unit>
            <trans-unit id="dashboard.currentBase.label"><source>Default probe base</source></trans-unit>

            <trans-unit id="dashboard.siteSelector.heading"><source>Site selector</source></trans-unit>
            <trans-unit id="dashboard.siteSelector.label"><source>Site</source></trans-unit>
            <trans-unit id="dashboard.siteSelector.help"><source>Choose a configured site before running the summary cards or the probe.</source></trans-unit>
            <trans-unit id="dashboard.siteSelector.submit"><source>Load site</source></trans-unit>
            <trans-unit id="dashboard.siteSelector.none"><source>No sites are configured yet.</source></trans-unit>

