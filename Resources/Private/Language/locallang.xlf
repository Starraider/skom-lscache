            <trans-unit id="manualPurge.flash.success.body"><source>Site %s | Scope %s | Request ID %s | Audit log %s</source></trans-unit>
            <trans-unit id="manualPurge.flash.failure.title"><source>Manual purge failed</source></trans-unit>
            <trans-unit id="manualPurge.flash.failure.body"><source>Site %s | Scope %s | Request ID %s | Audit log %s</source></trans-unit>

