            <trans-unit id="manualPurge.heading"><source>Manual Purge</source></trans-unit>
            <trans-unit id="manualPurge.description"><source>Trigger immediate page, tag, or full-site purge requests from the backend module.</source></trans-unit>
            <trans-unit id="manualPurge.scope.page.heading"><source>Purge Single Page</source></trans-unit>
            <trans-unit id="manualPurge.scope.page.description"><source>Purge exactly one page tag inside the selected site namespace.</source></trans-unit>
            <trans-unit id="manualPurge.scope.tags.heading"><source>Purge Tag Set</source></trans-unit>
            <trans-unit id="manualPurge.scope.tags.description"><source>Purge one or more tags that belong to the selected site namespace.</source></trans-unit>
            <trans-unit id="manualPurge.scope.site.heading"><source>Purge Entire Site</source></trans-unit>
            <trans-unit id="manualPurge.scope.site.description"><source>Flush the entire selected site namespace. Use only for urgent recovery.</source></trans-unit>
            <trans-unit id="manualPurge.form.site"><source>Site</source></trans-unit>
            <trans-unit id="manualPurge.form.pageUid"><source>Page UID</source></trans-unit>
            <trans-unit id="manualPurge.form.pageUid.help"><source>Use the page tree to identify the UID, then submit the purge.</source></trans-unit>
            <trans-unit id="manualPurge.form.tags"><source>Tags</source></trans-unit>
            <trans-unit id="manualPurge.form.tags.help"><source>Separate tags with spaces, commas, or line breaks.</source></trans-unit>
            <trans-unit id="manualPurge.form.tags.suggestions"><source>Recent tags for this site</source></trans-unit>
            <trans-unit id="manualPurge.form.confirmSitePurge"><source>I understand this purges all cache entries for the selected site.</source></trans-unit>
